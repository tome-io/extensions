{
  "workflowVersion": 1,
  "resources": {
    "catalog": {
      "steps": [
        {
          "id": "firebase",
          "when": { "$op": "in", "values": [{ "$op": "path", "path": "input.catalogId" }, ["current", "tbr", "interested", "finished", "dnf", "paused"]] },
          "request": {
            "urls": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword",
            "method": "POST",
            "query": { "key": "AIzaSyDCfBJ51pRZgHueBfBz0KNDiPNev1ClnGg" },
            "json": {
              "email": { "$op": "trim", "value": { "$op": "path", "path": "config.email" } },
              "password": { "$op": "path", "path": "config.password" },
              "returnSecureToken": true
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.idToken" }] }
        },
        {
          "id": "session",
          "when": { "$op": "path", "path": "steps.firebase.body.idToken" },
          "request": {
            "urls": "https://prod-pagebound-api.onrender.com/api/v1/auth/firebase_auth",
            "method": "POST",
            "json": { "id_token": { "$op": "path", "path": "steps.firebase.body.idToken" } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.token" }] }
        },
        {
          "id": "discovery",
          "when": { "$op": "in", "values": [{ "$op": "path", "path": "input.catalogId", "default": "emoji" }, ["emoji", "most_finished_yesterday", "most_tbr_yesterday", "most_discussed_yesterday"]] },
          "request": {
            "urls": "https://prod-pagebound-api.onrender.com/api/v1/books",
            "query": { "q": { "$op": "path", "path": "input.catalogId", "default": "emoji" } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "not", "value": { "$op": "path", "path": "response.body.error" } }] }
        },
        {
          "id": "library",
          "when": { "$op": "in", "values": [{ "$op": "path", "path": "input.catalogId" }, ["current", "tbr", "interested", "finished", "dnf", "paused"]] },
          "request": {
            "urls": "https://prod-pagebound-api.onrender.com/api/v1/user_books",
            "headers": { "Authorization": { "$op": "concat", "values": ["Bearer ", { "$op": "path", "path": "steps.session.body.token" }] } },
            "query": {
              "status": { "$op": "path", "path": "input.catalogId" },
              "page": { "$op": "path", "path": "input.page", "default": 1 },
              "sort_by": "added_at",
              "asc": false
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.user_books" }] }
        }
      ],
      "output": {
        "items": {
          "$op": "map",
          "value": {
            "$op": "if",
            "values": [
              { "$op": "path", "path": "steps.library.body.user_books" },
              { "$op": "path", "path": "steps.library.body.user_books" },
              {
                "$op": "slice",
                "value": { "$op": "coalesce", "values": [{ "$op": "path", "path": "steps.discovery.body.books" }, { "$op": "path", "path": "steps.discovery.body" }] },
                "values": [
                  { "$op": "multiply", "values": [{ "$op": "add", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, -1] }, { "$op": "path", "path": "input.limit", "default": 20 }] },
                  { "$op": "multiply", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, { "$op": "path", "path": "input.limit", "default": 20 }] }
                ]
              }
            ]
          },
          "as": "book",
          "values": [{
            "$op": "compact",
            "value": {
              "id": { "$op": "coalesce", "values": [{ "$op": "path", "path": "book.book_uuid" }, { "$op": "path", "path": "book.uuid" }] },
              "title": { "$op": "path", "path": "book.title" },
              "authors": { "$op": "compact", "value": [{ "$op": "path", "path": "book.author_name" }] },
              "description": { "$op": "path", "path": "book.description" },
              "coverUrl": { "$op": "path", "path": "book.image_url" },
              "publishedYear": { "$op": "multiply", "values": [{ "$op": "path", "path": "book.pub_year" }, 1] },
              "subjects": [],
              "identifiers": { "$op": "compact", "value": { "pagebound": { "$op": "coalesce", "values": [{ "$op": "path", "path": "book.book_uuid" }, { "$op": "path", "path": "book.uuid" }] }, "goodreads": { "$op": "string", "value": { "$op": "path", "path": "book.goodreads_id" } } } },
              "rating": { "$op": "multiply", "values": [{ "$op": "path", "path": "book.aggregate_ratings.overall" }, 1] },
              "ratingsCount": { "$op": "path", "path": "book.aggregate_ratings.ratings_count" },
              "seriesPosition": { "$op": "multiply", "values": [{ "$op": "path", "path": "book.series_sequence" }, 1] },
              "infoUrl": { "$op": "concat", "values": ["https://pagebound.co/books/", { "$op": "coalesce", "values": [{ "$op": "path", "path": "book.book_uuid" }, { "$op": "path", "path": "book.uuid" }] }] }
            }
          }]
        },
        "nextPage": { "$op": "if", "values": [
          { "$op": "if", "values": [
            { "$op": "path", "path": "steps.library.body.user_books" },
            { "$op": "lessThan", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, { "$op": "path", "path": "steps.library.body.total_pages" }] },
            { "$op": "lessThan", "values": [{ "$op": "multiply", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, { "$op": "path", "path": "input.limit", "default": 20 }] }, { "$op": "length", "value": { "$op": "coalesce", "values": [{ "$op": "path", "path": "steps.discovery.body.books" }, { "$op": "path", "path": "steps.discovery.body" }] } }] }
          ] },
          { "$op": "add", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, 1] }, null
        ] }
      }
    },
    "search": {
      "steps": [{
        "id": "search",
        "when": { "$op": "trim", "value": { "$op": "path", "path": "input.query" } },
        "request": {
          "urls": "https://hztadco4ku1vqi6lp.a1.typesense.net/collections/books/documents/search",
          "headers": { "X-TYPESENSE-API-KEY": "SgSrp2Vx4V4wjJAwnME6uWUufNdi9BxM" },
          "query": {
            "q": { "$op": "path", "path": "input.query" },
            "query_by": "title,author_name",
            "sort_by": "rating_count:desc",
            "page": { "$op": "path", "path": "input.page", "default": 1 },
            "per_page": 24
          }
        },
        "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.hits" }] }
      }],
      "output": {
        "items": {
          "$op": "map", "value": { "$op": "path", "path": "steps.search.body.hits", "default": [] }, "as": "hit",
          "values": [{
            "$op": "compact", "value": {
              "id": { "$op": "path", "path": "hit.document.uuid" },
              "title": { "$op": "path", "path": "hit.document.title" },
              "authors": { "$op": "compact", "value": [{ "$op": "path", "path": "hit.document.author_name" }] },
              "description": { "$op": "path", "path": "hit.document.description" },
              "coverUrl": { "$op": "path", "path": "hit.document.image_url" },
              "subjects": [],
              "identifiers": { "pagebound": { "$op": "path", "path": "hit.document.uuid" } },
              "ratingsCount": { "$op": "path", "path": "hit.document.rating_count" },
              "infoUrl": { "$op": "concat", "values": ["https://pagebound.co/books/", { "$op": "path", "path": "hit.document.uuid" }] }
            }
          }]
        },
        "nextPage": { "$op": "if", "values": [
          { "$op": "lessThan", "values": [{ "$op": "multiply", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, 24] }, { "$op": "path", "path": "steps.search.body.found" }] },
          { "$op": "add", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, 1] }, null
        ] }
      }
    },
    "meta": {
      "steps": [
        {
          "id": "book",
          "request": {
            "urls": { "$op": "concat", "values": ["https://prod-pagebound-api.onrender.com/api/v1/books/", { "$op": "encode", "value": { "$op": "path", "path": "input.id" } }] }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.book.uuid" }] }
        }
      ],
      "output": {
        "$op": "compact", "value": {
          "id": { "$op": "path", "path": "steps.book.body.book.uuid" },
          "title": { "$op": "path", "path": "steps.book.body.book.title" },
          "authors": { "$op": "compact", "value": [{ "$op": "path", "path": "steps.book.body.book.author_name" }] },
          "description": { "$op": "path", "path": "steps.book.body.book.description" },
          "coverUrl": { "$op": "path", "path": "steps.book.body.book.image_url" },
          "publishedYear": { "$op": "multiply", "values": [{ "$op": "path", "path": "steps.book.body.book.pub_year" }, 1] },
          "subjects": { "$op": "map", "value": { "$op": "path", "path": "steps.book.body.book.tags" }, "as": "tag", "values": [{ "$op": "path", "path": "tag.name" }] },
          "identifiers": { "$op": "compact", "value": { "pagebound": { "$op": "path", "path": "steps.book.body.book.uuid" }, "goodreads": { "$op": "string", "value": { "$op": "path", "path": "steps.book.body.book.goodreads_id" } } } },
          "rating": { "$op": "multiply", "values": [{ "$op": "path", "path": "steps.book.body.book.aggregate_ratings.overall" }, 1] },
          "ratingsCount": { "$op": "path", "path": "steps.book.body.book.aggregate_ratings.ratings_count" },
          "seriesPosition": { "$op": "multiply", "values": [{ "$op": "path", "path": "steps.book.body.book.series_sequence" }, 1] },
          "infoUrl": { "$op": "concat", "values": ["https://pagebound.co/books/", { "$op": "path", "path": "steps.book.body.book.uuid" }] }
        }
      }
    },
    "resolve": {
      "steps": [
        {
          "id": "firebase",
          "when": { "$op": "path", "path": "input.book.identifiers.pagebound" },
          "request": {
            "urls": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword",
            "method": "POST",
            "query": { "key": "AIzaSyDCfBJ51pRZgHueBfBz0KNDiPNev1ClnGg" },
            "json": {
              "email": { "$op": "trim", "value": { "$op": "path", "path": "config.email" } },
              "password": { "$op": "path", "path": "config.password" },
              "returnSecureToken": true
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.idToken" }] }
        },
        {
          "id": "session",
          "when": { "$op": "path", "path": "input.book.identifiers.pagebound" },
          "request": {
            "urls": "https://prod-pagebound-api.onrender.com/api/v1/auth/firebase_auth",
            "method": "POST",
            "json": { "id_token": { "$op": "path", "path": "steps.firebase.body.idToken" } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.token" }] }
        },
        {
          "id": "book",
          "when": { "$op": "path", "path": "input.book.identifiers.pagebound" },
          "request": {
            "urls": { "$op": "concat", "values": ["https://prod-pagebound-api.onrender.com/api/v1/books/", { "$op": "encode", "value": { "$op": "path", "path": "input.book.identifiers.pagebound" } }] },
            "headers": { "Authorization": { "$op": "concat", "values": ["Bearer ", { "$op": "path", "path": "steps.session.body.token" }] } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.book.uuid" }] }
        },
        {
          "id": "search",
          "when": { "$op": "and", "values": [{ "$op": "not", "value": { "$op": "path", "path": "input.book.identifiers.pagebound" } }, { "$op": "trim", "value": { "$op": "path", "path": "input.book.title" } }] },
          "request": {
            "urls": "https://hztadco4ku1vqi6lp.a1.typesense.net/collections/books/documents/search",
            "headers": { "X-TYPESENSE-API-KEY": "SgSrp2Vx4V4wjJAwnME6uWUufNdi9BxM" },
            "query": {
              "q": { "$op": "path", "path": "input.book.title" },
              "query_by": "title",
              "num_typos": 0,
              "prefix": false,
              "drop_tokens_threshold": 0,
              "per_page": 24
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.hits" }] }
        }
      ],
      "output": {
        "items": {
          "$op": "map",
          "value": {
            "$op": "filter", "value": { "$op": "if", "values": [{ "$op": "path", "path": "steps.book.body.book.uuid" }, [{ "document": { "$op": "path", "path": "steps.book.body.book" } }], { "$op": "path", "path": "steps.search.body.hits", "default": [] }] }, "as": "hit",
            "values": [{ "$op": "if", "values": [
              { "$op": "path", "path": "input.book.identifiers.pagebound" },
              { "$op": "equals", "values": [{ "$op": "path", "path": "hit.document.uuid" }, { "$op": "path", "path": "input.book.identifiers.pagebound" }] },
              { "$op": "and", "values": [
                { "$op": "equals", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "hit.document.title" } } }, { "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "input.book.title" } } }] },
                { "$op": "in", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "hit.document.author_name" } } }, { "$op": "map", "value": { "$op": "path", "path": "input.book.authors" }, "as": "author", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "author" } } }] }] }
              ] }
            ] }]
          },
          "as": "hit",
          "values": [{
            "$op": "compact", "value": {
              "id": { "$op": "path", "path": "hit.document.uuid" },
              "title": { "$op": "path", "path": "hit.document.title" },
              "authors": { "$op": "compact", "value": [{ "$op": "path", "path": "hit.document.author_name" }] },
              "description": { "$op": "path", "path": "hit.document.description" },
              "coverUrl": { "$op": "path", "path": "hit.document.image_url" },
              "subjects": [],
              "identifiers": { "pagebound": { "$op": "path", "path": "hit.document.uuid" } },
              "infoUrl": { "$op": "concat", "values": ["https://pagebound.co/books/", { "$op": "path", "path": "hit.document.uuid" }] }
            }
          }]
        }
      }
    },
    "reviews": {
      "steps": [
        {
          "id": "search",
          "when": { "$op": "and", "values": [{ "$op": "not", "value": { "$op": "path", "path": "input.book.identifiers.pagebound" } }, { "$op": "trim", "value": { "$op": "path", "path": "input.book.title" } }, { "$op": "path", "path": "input.book.authors.0" }] },
          "request": {
            "urls": "https://hztadco4ku1vqi6lp.a1.typesense.net/collections/books/documents/search",
            "headers": { "X-TYPESENSE-API-KEY": "SgSrp2Vx4V4wjJAwnME6uWUufNdi9BxM" },
            "query": {
              "q": { "$op": "concat", "values": [{ "$op": "path", "path": "input.book.title" }, " ", { "$op": "path", "path": "input.book.authors.0" }] },
              "query_by": "title,author_name",
              "num_typos": 0,
              "prefix": false,
              "drop_tokens_threshold": 0,
              "per_page": 2
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.hits" }] }
        },
        {
          "id": "firebase",
          "when": { "$op": "coalesce", "values": [
            { "$op": "path", "path": "input.book.identifiers.pagebound" },
            { "$op": "and", "values": [
              { "$op": "equals", "values": [{ "$op": "path", "path": "steps.search.body.found" }, 1] },
              { "$op": "equals", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "steps.search.body.hits.0.document.title" } } }, { "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "input.book.title" } } }] },
              { "$op": "in", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "steps.search.body.hits.0.document.author_name" } } }, { "$op": "map", "value": { "$op": "path", "path": "input.book.authors" }, "as": "author", "values": [{ "$op": "lowercase", "value": { "$op": "trim", "value": { "$op": "path", "path": "author" } } }] }] }
            ] }
          ] },
          "request": {
            "urls": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword",
            "method": "POST",
            "query": { "key": "AIzaSyDCfBJ51pRZgHueBfBz0KNDiPNev1ClnGg" },
            "json": {
              "email": { "$op": "trim", "value": { "$op": "path", "path": "config.email" } },
              "password": { "$op": "path", "path": "config.password" },
              "returnSecureToken": true
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.idToken" }] }
        },
        {
          "id": "session",
          "when": { "$op": "path", "path": "steps.firebase.body.idToken" },
          "request": {
            "urls": "https://prod-pagebound-api.onrender.com/api/v1/auth/firebase_auth",
            "method": "POST",
            "json": { "id_token": { "$op": "path", "path": "steps.firebase.body.idToken" } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.token" }] }
        },
        {
          "id": "book",
          "when": { "$op": "path", "path": "steps.session.body.token" },
          "request": {
            "urls": { "$op": "concat", "values": ["https://prod-pagebound-api.onrender.com/api/v1/books/", { "$op": "encode", "value": { "$op": "coalesce", "values": [{ "$op": "path", "path": "input.book.identifiers.pagebound" }, { "$op": "path", "path": "steps.search.body.hits.0.document.uuid" }] } }] },
            "headers": { "Authorization": { "$op": "concat", "values": ["Bearer ", { "$op": "path", "path": "steps.session.body.token" }] } }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.book.id" }] }
        },
        {
          "id": "reviews",
          "when": { "$op": "path", "path": "steps.book.body.book.id" },
          "request": {
            "urls": { "$op": "concat", "values": ["https://prod-pagebound-api.onrender.com/api/v1/books/", { "$op": "path", "path": "steps.book.body.book.id" }, "/reviews"] },
            "headers": { "Authorization": { "$op": "concat", "values": ["Bearer ", { "$op": "path", "path": "steps.session.body.token" }] } },
            "query": {
              "page": { "$op": "path", "path": "input.page", "default": 1 },
              "only_written_reviews": true,
              "only_following": false,
              "sort_by": "most_upvotes"
            }
          },
          "accept": { "$op": "and", "values": [{ "$op": "path", "path": "response.ok" }, { "$op": "path", "path": "response.body.reviews" }] }
        }
      ],
      "output": {
        "items": {
          "$op": "map",
          "value": { "$op": "filter", "value": { "$op": "path", "path": "steps.reviews.body.reviews", "default": [] }, "as": "review", "values": [{ "$op": "and", "values": [{ "$op": "trim", "value": { "$op": "path", "path": "review.review" } }, { "$op": "not", "value": { "$op": "path", "path": "review.is_blocked" } }, { "$op": "not", "value": { "$op": "path", "path": "review.is_flagged" } }] }] },
          "as": "review",
          "values": [{
            "$op": "compact", "value": {
              "id": { "$op": "string", "value": { "$op": "path", "path": "review.id" } },
              "author": { "$op": "path", "path": "review.username" },
              "text": { "$op": "path", "path": "review.review" },
              "rating": { "$op": "multiply", "values": [{ "$op": "path", "path": "review.overall_rating" }, 1] },
              "reviewedAt": { "$op": "path", "path": "review.created_at" },
              "containsSpoilers": { "$op": "path", "path": "review.is_spoiler" },
              "likesCount": { "$op": "path", "path": "review.upvotes" },
              "authorAvatarUrl": { "$op": "if", "values": [{ "$op": "path", "path": "review.user_image_url" }, { "$op": "absoluteUrl", "value": { "$op": "path", "path": "review.user_image_url" }, "base": "https://cdn.pagebound.co" }, null] },
              "authorUrl": { "$op": "concat", "values": ["https://pagebound.co/users/", { "$op": "encode", "value": { "$op": "path", "path": "review.username" } }] }
            }
          }]
        },
        "nextPage": { "$op": "if", "values": [
          { "$op": "lessThan", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, { "$op": "path", "path": "steps.reviews.body.total_pages" }] },
          { "$op": "add", "values": [{ "$op": "path", "path": "input.page", "default": 1 }, 1] }, null
        ] }
      }
    }
  }
}
