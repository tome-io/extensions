{
  "manifestVersion": 1,
  "id": "community.tomeio.pagebound",
  "version": "0.1.4",
  "name": "Pagebound",
  "description": "Pagebound discovery, personal library shelves, search, covers, ratings, and reader reviews.",
  "author": "Tomeio community",
  "homepage": "https://pagebound.co",
  "repository": "https://github.com/tome-io/extensions/tree/main/community/pagebound",
  "icon": "https://raw.githubusercontent.com/tome-io/extensions/main/community/pagebound/icon.webp",
  "types": ["book"],
  "resources": [
    { "name": "catalog", "supportsPagination": true },
    { "name": "search", "supportsPagination": true },
    { "name": "meta" },
    { "name": "resolve" },
    { "name": "reviews", "supportsPagination": true }
  ],
  "providerRoles": ["discovery", "search", "cover", "reviews"],
  "catalogs": [
    { "id": "emoji", "name": "Today's featured emoji", "resource": "catalog" },
    { "id": "most_finished_yesterday", "name": "Most finished yesterday", "resource": "catalog" },
    { "id": "most_tbr_yesterday", "name": "Most added to TBR yesterday", "resource": "catalog" },
    { "id": "most_discussed_yesterday", "name": "Most discussed yesterday", "resource": "catalog" },
    { "id": "current", "name": "My library: Reading", "resource": "catalog" },
    { "id": "tbr", "name": "My library: To be read", "resource": "catalog" },
    { "id": "interested", "name": "My library: Interested", "resource": "catalog" },
    { "id": "finished", "name": "My library: Finished", "resource": "catalog" },
    { "id": "dnf", "name": "My library: Did not finish", "resource": "catalog" },
    { "id": "paused", "name": "My library: Paused", "resource": "catalog" }
  ],
  "config": [
    { "key": "email", "type": "text", "title": "Pagebound email", "required": true },
    { "key": "password", "type": "password", "title": "Pagebound password", "required": true }
  ],
  "behaviorHints": { "configurable": true, "configurationRequired": true },
  "attribution": { "label": "Data from Pagebound", "url": "https://pagebound.co" },
  "transport": {
    "kind": "declarative",
    "definitionUrl": "https://raw.githubusercontent.com/tome-io/extensions/main/community/pagebound/workflow.json"
  },
  "permissions": {
    "hosts": [
      "https://raw.githubusercontent.com",
      "https://identitytoolkit.googleapis.com",
      "https://prod-pagebound-api.onrender.com",
      "https://hztadco4ku1vqi6lp.a1.typesense.net"
    ]
  }
}
