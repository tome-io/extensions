{
  "deviceWorkflowVersion": 1,
  "resources": {
    "reader": {
      "steps": [
        {
          "id": "backups",
          "operation": {
            "kind": "directory.scan",
            "directory": { "$op": "path", "path": "config.backup_directory" },
            "filenames": ["cloud.backup"],
            "extensions": ["mrpro"],
            "maxDepth": 4,
            "limit": 1,
            "order": "modified-desc"
          }
        },
        {
          "id": "names",
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "steps.backups.files.0.uri" },
            "entry": { "suffix": "/_names.list" },
            "response": "text"
          }
        },
        {
          "id": "positions",
          "optional": true,
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "steps.backups.files.0.uri" },
            "entry": {
              "indexed": { "$op": "path", "path": "steps.names" },
              "targetSuffix": "/shared_prefs/positions10.xml"
            },
            "response": "text"
          }
        },
        {
          "id": "preferences",
          "optional": true,
          "when": { "$op": "path", "path": "steps.positions.text" },
          "operation": {
            "kind": "android.preferences.parse",
            "text": { "$op": "path", "path": "steps.positions" }
          }
        },
        {
          "id": "database",
          "optional": true,
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "steps.backups.files.0.uri" },
            "entry": {
              "indexed": { "$op": "path", "path": "steps.names" },
              "targetSuffix": "/databases/mrbooks.db"
            },
            "response": "bytes"
          }
        },
        {
          "id": "sqlite",
          "optional": true,
          "when": { "$op": "path", "path": "steps.database.bytes" },
          "operation": {
            "kind": "sqlite.query",
            "database": { "$op": "path", "path": "steps.database" },
            "queries": {
              "books": "SELECT book, filename, author, description, category, addTime FROM books",
              "statistics": "SELECT filename, usedTime, readWords, dates FROM statistics"
            }
          }
        }
      ],
      "output": {
        "books": {
          "$op": "map",
          "value": {
            "$op": "distinct",
            "value": {
              "$op": "compact",
              "value": {
                "$op": "flatten",
                "value": [
                  {
                    "$op": "map",
                    "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                    "as": "row",
                    "values": [
                      { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "row.filename" } } }
                    ]
                  },
                  {
                    "$op": "map",
                    "value": { "$op": "path", "path": "steps.sqlite.statistics", "default": [] },
                    "as": "row",
                    "values": [
                      { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "row.filename" } } }
                    ]
                  },
                  {
                    "$op": "map",
                    "value": { "$op": "path", "path": "steps.preferences.entries", "default": [] },
                    "as": "entry",
                    "values": [
                      { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "entry.key" } } }
                    ]
                  }
                ]
              }
            }
          },
          "as": "filename",
          "values": [
            {
              "sourceId": { "$op": "path", "path": "filename" },
              "id": { "$op": "concat", "values": ["moonreader:", { "$op": "encode", "value": { "$op": "path", "path": "filename" } }] },
              "title": {
                "$op": "coalesce",
                "values": [
                  {
                    "$op": "get",
                    "value": {
                      "$op": "find",
                      "value": { "$op": "path", "path": "input.books", "default": [] },
                      "as": "local",
                      "values": [
                        {
                          "$op": "equals",
                          "values": [
                            { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "local.localFile.filename" } } },
                            { "$op": "path", "path": "filename" }
                          ]
                        }
                      ]
                    },
                    "path": "title"
                  },
                  {
                    "$op": "trim",
                    "value": {
                      "$op": "get",
                      "value": {
                        "$op": "find",
                        "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                        "as": "metadata",
                        "values": [
                          {
                            "$op": "equals",
                            "values": [
                              { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "metadata.filename" } } },
                              { "$op": "path", "path": "filename" }
                            ]
                          }
                        ]
                      },
                      "path": "book"
                    }
                  },
                  { "$op": "fileStem", "value": { "$op": "path", "path": "filename" } }
                ]
              },
              "authors": {
                "$op": "compact",
                "value": {
                  "$op": "array",
                  "value": {
                    "$op": "coalesce",
                    "values": [
                      {
                        "$op": "get",
                        "value": {
                          "$op": "find",
                          "value": { "$op": "path", "path": "input.books", "default": [] },
                          "as": "local",
                          "values": [
                            {
                              "$op": "equals",
                              "values": [
                                { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "local.localFile.filename" } } },
                                { "$op": "path", "path": "filename" }
                              ]
                            }
                          ]
                        },
                        "path": "authors.0"
                      },
                      {
                        "$op": "trim",
                        "value": {
                          "$op": "get",
                          "value": {
                            "$op": "find",
                            "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                            "as": "metadata",
                            "values": [
                              {
                                "$op": "equals",
                                "values": [
                                  { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "metadata.filename" } } },
                                  { "$op": "path", "path": "filename" }
                                ]
                              }
                            ]
                          },
                          "path": "author"
                        }
                      }
                    ]
                  }
                }
              },
              "identifiers": {},
              "description": {
                "$op": "get",
                "value": {
                  "$op": "find",
                  "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                  "as": "metadata",
                  "values": [
                    {
                      "$op": "equals",
                      "values": [
                        { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "metadata.filename" } } },
                        { "$op": "path", "path": "filename" }
                      ]
                    }
                  ]
                },
                "path": "description"
              },
              "format": { "$op": "fileExtension", "value": { "$op": "path", "path": "filename" } },
              "sourceFilename": { "$op": "path", "path": "filename" },
              "sourcePath": {
                "$op": "coalesce",
                "values": [
                  {
                    "$op": "get",
                    "value": {
                      "$op": "find",
                      "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                      "as": "metadata",
                      "values": [
                        {
                          "$op": "equals",
                          "values": [
                            { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "metadata.filename" } } },
                            { "$op": "path", "path": "filename" }
                          ]
                        }
                      ]
                    },
                    "path": "filename"
                  },
                  {
                    "$op": "get",
                    "value": {
                      "$op": "find",
                      "value": { "$op": "path", "path": "steps.preferences.entries", "default": [] },
                      "as": "position",
                      "values": [
                        {
                          "$op": "equals",
                          "values": [
                            { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "position.key" } } },
                            { "$op": "path", "path": "filename" }
                          ]
                        }
                      ]
                    },
                    "path": "key"
                  }
                ]
              },
              "addedAt": {
                "$op": "coalesce",
                "values": [
                  {
                    "$op": "number",
                    "value": {
                      "$op": "get",
                      "value": {
                        "$op": "find",
                        "value": { "$op": "path", "path": "steps.sqlite.books", "default": [] },
                        "as": "metadata",
                        "values": [
                          {
                            "$op": "equals",
                            "values": [
                              { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "metadata.filename" } } },
                              { "$op": "path", "path": "filename" }
                            ]
                          }
                        ]
                      },
                      "path": "addTime"
                    }
                  },
                  { "$op": "path", "path": "steps.backups.files.0.modificationTime" }
                ]
              },
              "progress": {
                "$op": "coalesce",
                "values": [
                  {
                    "$op": "percent",
                    "value": {
                      "$op": "get",
                      "value": {
                        "$op": "find",
                        "value": { "$op": "path", "path": "steps.preferences.entries", "default": [] },
                        "as": "position",
                        "values": [
                          {
                            "$op": "equals",
                            "values": [
                              { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "position.key" } } },
                              { "$op": "path", "path": "filename" }
                            ]
                          }
                        ]
                      },
                      "path": "value"
                    }
                  },
                  {
                    "$op": "percent",
                    "value": {
                      "$op": "get",
                      "value": {
                        "$op": "find",
                        "value": { "$op": "path", "path": "steps.sqlite.statistics", "default": [] },
                        "as": "statistics",
                        "values": [
                          {
                            "$op": "equals",
                            "values": [
                              { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "statistics.filename" } } },
                              { "$op": "path", "path": "filename" }
                            ]
                          }
                        ]
                      },
                      "path": "dates"
                    }
                  }
                ]
              },
              "readingTimeMs": {
                "$op": "number",
                "value": {
                  "$op": "get",
                  "value": {
                    "$op": "find",
                    "value": { "$op": "path", "path": "steps.sqlite.statistics", "default": [] },
                    "as": "statistics",
                    "values": [
                      {
                        "$op": "equals",
                        "values": [
                          { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "statistics.filename" } } },
                          { "$op": "path", "path": "filename" }
                        ]
                      }
                    ]
                  },
                  "path": "usedTime"
                }
              },
              "wordsRead": {
                "$op": "number",
                "value": {
                  "$op": "get",
                  "value": {
                    "$op": "find",
                    "value": { "$op": "path", "path": "steps.sqlite.statistics", "default": [] },
                    "as": "statistics",
                    "values": [
                      {
                        "$op": "equals",
                        "values": [
                          { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "statistics.filename" } } },
                          { "$op": "path", "path": "filename" }
                        ]
                      }
                    ]
                  },
                  "path": "readWords"
                }
              },
              "lastReadAt": {
                "$op": "multiply",
                "values": [
                  {
                    "$op": "max",
                    "value": {
                      "$op": "map",
                      "value": {
                        "$op": "split",
                        "value": {
                          "$op": "get",
                          "value": {
                            "$op": "find",
                            "value": { "$op": "path", "path": "steps.sqlite.statistics", "default": [] },
                            "as": "statistics",
                            "values": [
                              {
                                "$op": "equals",
                                "values": [
                                  { "$op": "lowercase", "value": { "$op": "basename", "value": { "$op": "path", "path": "statistics.filename" } } },
                                  { "$op": "path", "path": "filename" }
                                ]
                              }
                            ]
                          },
                          "path": "dates"
                        },
                        "separator": "\n"
                      },
                      "as": "dateLine",
                      "values": [
                        {
                          "$op": "number",
                          "value": {
                            "$op": "first",
                            "value": { "$op": "split", "value": { "$op": "path", "path": "dateLine" }, "separator": "|" }
                          }
                        }
                      ]
                    }
                  },
                  86400000
                ]
              }
            }
          ]
        },
        "warnings": {
          "$op": "compact",
          "value": [
            { "$op": "path", "path": "steps.positions.error" },
            { "$op": "path", "path": "steps.preferences.error" },
            { "$op": "path", "path": "steps.database.error" },
            { "$op": "path", "path": "steps.sqlite.error" }
          ]
        }
      }
    },
    "libraryAction": {
      "steps": [
        {
          "id": "open",
          "operation": {
            "kind": "android.open-file",
            "uri": { "$op": "path", "path": "input.book.localFile.uri" },
            "format": { "$op": "path", "path": "input.book.localFile.format" },
            "packages": [
              "com.flyersoft.moonreaderp",
              "com.flyersoft.moonreader"
            ],
            "activitySuffix": "ActivityMain",
            "mimeTypes": {
              "azw3": "application/x-kindle-application",
              "cbr": "application/x-cbr",
              "cbz": "application/x-cbz",
              "djvu": "application/djvu",
              "epub": "application/epub+zip",
              "fb2": "application/x-fb2",
              "mobi": "application/x-mobipocket-ebook",
              "pdf": "application/pdf"
            }
          }
        }
      ],
      "output": { "$op": "path", "path": "steps.open" }
    }
  }
}
