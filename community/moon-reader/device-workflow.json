{
  "deviceWorkflowVersion": 1,
  "resources": {
    "libraryImport": {
      "steps": [
        {
          "id": "index",
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "input.sourceUri" },
            "entry": { "suffix": "/_names.list" },
            "response": "text"
          }
        },
        {
          "id": "database",
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "input.sourceUri" },
            "entry": {
              "indexed": { "$op": "path", "path": "steps.index" },
              "targetSuffix": "/databases/mrbooks.db",
              "entryExtension": ".tag"
            },
            "response": "bytes"
          }
        },
        {
          "id": "positions-file",
          "operation": {
            "kind": "archive.read",
            "archive": { "$op": "path", "path": "input.sourceUri" },
            "entry": {
              "indexed": { "$op": "path", "path": "steps.index" },
              "targetSuffix": "/shared_prefs/positions10.xml",
              "entryExtension": ".tag"
            },
            "response": "text"
          }
        },
        {
          "id": "catalog",
          "operation": {
            "kind": "sqlite.query",
            "database": { "$op": "path", "path": "steps.database" },
            "queries": {
              "books": "SELECT b.book, b.filename, b.author, b.addTime, s.usedTime, s.readWords, s.dates FROM books AS b LEFT JOIN statistics AS s ON s.filename = b.filename"
            }
          }
        },
        {
          "id": "positions",
          "operation": {
            "kind": "android.preferences.parse",
            "text": { "$op": "path", "path": "steps.positions-file" }
          }
        }
      ],
      "output": {
        "books": {
          "$op": "map",
          "value": {
            "$op": "filter",
            "value": { "$op": "path", "path": "steps.catalog.books" },
            "as": "candidate",
            "values": [{ "$op": "path", "path": "candidate.filename" }]
          },
          "as": "book",
          "values": [
            {
              "sourceId": {
                "$op": "lowercase",
                "value": {
                  "$op": "basename",
                  "value": { "$op": "path", "path": "book.filename" }
                }
              },
              "title": {
                "$op": "coalesce",
                "values": [
                  { "$op": "trim", "value": { "$op": "path", "path": "book.book" } },
                  { "$op": "fileStem", "value": { "$op": "path", "path": "book.filename" } }
                ]
              },
              "authors": [
                {
                  "$op": "coalesce",
                  "values": [
                    {
                      "$op": "trim",
                      "value": {
                        "$op": "split",
                        "value": { "$op": "path", "path": "book.author" },
                        "separator": ";",
                        "index": 0
                      }
                    },
                    "Unknown"
                  ]
                }
              ],
              "identifiers": {},
              "format": {
                "$op": "uppercase",
                "value": {
                  "$op": "fileExtension",
                  "value": { "$op": "path", "path": "book.filename" }
                }
              },
              "sourceFilename": {
                "$op": "basename",
                "value": { "$op": "path", "path": "book.filename" }
              },
              "sourcePath": { "$op": "path", "path": "book.filename" },
              "addedAt": {
                "$op": "number",
                "value": { "$op": "path", "path": "book.addTime" }
              },
              "progress": {
                "$op": "max",
                "value": [
                  {
                    "$op": "percent",
                    "value": {
                      "$op": "lookup",
                      "value": { "$op": "path", "path": "steps.positions.byBasename" },
                      "by": {
                        "$op": "lowercase",
                        "value": {
                          "$op": "basename",
                          "value": { "$op": "path", "path": "book.filename" }
                        }
                      }
                    }
                  },
                  {
                    "$op": "percent",
                    "value": { "$op": "path", "path": "book.dates" }
                  }
                ]
              },
              "readingTimeMs": {
                "$op": "number",
                "value": { "$op": "path", "path": "book.usedTime" }
              },
              "wordsRead": {
                "$op": "number",
                "value": { "$op": "path", "path": "book.readWords" }
              }
            }
          ]
        }
      }
    },
    "libraryAction": {
      "steps": [
        {
          "id": "open",
          "operation": {
            "kind": "android.open-file",
            "uri": { "$op": "path", "path": "input.book.localFile.uri" },
            "format": { "$op": "path", "path": "input.book.localFile.format" },
            "packages": [
              "com.flyersoft.moonreaderp",
              "com.flyersoft.moonreader"
            ],
            "activitySuffix": "ActivityMain",
            "mimeTypes": {
              "azw3": "application/x-kindle-application",
              "cbr": "application/x-cbr",
              "cbz": "application/x-cbz",
              "djvu": "application/djvu",
              "epub": "application/epub+zip",
              "fb2": "application/x-fb2",
              "mobi": "application/x-mobipocket-ebook",
              "pdf": "application/pdf"
            }
          }
        }
      ],
      "output": { "$op": "path", "path": "steps.open" }
    }
  }
}
